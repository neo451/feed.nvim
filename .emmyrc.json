{
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "?.lua",
      "?/init.lua",
      "lua/?.lua",
      "lua/?/init.lua",
      "?/lua/?.lua",
      "?/lua/?/init.lua"
    ]
  },
  "strict": {
    "typeCall": true,
    "arrayIndex": true
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "$VIMRUNTIME"
    ]
  }
}
